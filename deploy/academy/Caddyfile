# Replace with the reserved academy IPv4 address or internal DNS name.
# Clients must trust this Caddy instance's internal root CA before screen capture works.
https://CHANGE_ME_ACADEMY_IP_OR_DNS {
    tls internal
    encode zstd gzip

    handle_path /media/* {
