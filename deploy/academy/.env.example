# Copy to /etc/madi/madi.env (root:madi, mode 0640). Replace every CHANGE_ME.
# systemd EnvironmentFile syntax: no export; quote values containing spaces.
MADI_HOST=127.0.0.1
MADI_PORT=8000
MADI_ALLOWED_HOSTS=CHANGE_ME_ACADEMY_IP_OR_DNS
MADI_DATABASE_URL=postgresql://madi:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/madi
MADI_DB_POOL_SIZE=10
MADI_FILE_DIR=/var/lib/madi/files
MADI_LOG_FILE=/var/log/madi/madi.log
MADI_LOG_LEVEL=INFO
MADI_SESSION_HOURS=12
MADI_SFU_URL=wss://CHANGE_ME_ACADEMY_IP_OR_DNS/media
LIVEKIT_API_KEY=CHANGE_ME_MEDIA_KEY
LIVEKIT_API_SECRET=CHANGE_ME_MEDIA_SECRET

# Optional distributed classroom SFUs; takes precedence over global SFU above.
# Operator-owned JSON with independent credentials per classroom; see docs/classroom-media.md.
# MADI_CLASSROOMS_FILE=/etc/madi/classrooms.json
